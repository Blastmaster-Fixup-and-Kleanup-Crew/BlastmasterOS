#include <windef.h>
#include <winuser.h>

#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

#define REACTOS_STR_FILE_DESCRIPTION  "FreeCell"
#define REACTOS_STR_INTERNAL_NAME     "FreeCell"
#define REACTOS_STR_ORIGINAL_FILENAME "freecell.exe"

#include <reactos/version.rc>

IDI_FREECELL ICON "freecell.ico"

IDR_MENU1 MENU
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&New Game", IDM_GAME_NEW
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_GAME_EXIT
    END

    POPUP "&Help"
    BEGIN
        MENUITEM "&About FreeCell", IDM_HELP_ABOUT
    END
END

IDR_ACCELERATOR1 ACCELERATORS
BEGIN
    "N", IDM_GAME_NEW, VIRTKEY, CONTROL
END

STRINGTABLE
BEGIN
    IDS_FREECELL_NAME
        "FreeCell"

    IDS_FREECELL_ABOUT
        "FreeCell for BlastmasterOS"

    IDS_FREECELL_QUIT
        "Are you sure you want to quit FreeCell?"

    IDS_FREECELL_WIN
        "Congratulations! You won the game."
END

#include <reactos/manifest_exe.rc>
